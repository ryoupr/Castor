{
  "manifest_version": 3,
  "name": "Castor - Gemini UI Enhancer",
  "version": "1.0.0",
  "description": "Gemini の UI を改善する Chrome 拡張機能（横幅拡大・最下部スクロールボタン）",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content-script.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}
